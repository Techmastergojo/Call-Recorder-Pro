<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose apps don't need an XML theme for UI — Compose handles all styling.
        We just need a thin wrapper that:
         - Hides the action bar (Compose draws its own top bar)
         - Sets a dark status bar
         - Uses a dark window background
        Theme.DeviceDefault.NoActionBar is always available on every Android device.
    -->
    <style name="Theme.RecordPro" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
